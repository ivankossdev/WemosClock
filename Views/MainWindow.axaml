<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:WemosClock.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:conv="clr-namespace:Avalonia.Data.Converters;assembly=Avalonia"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="WemosClock.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="WemosClock"
        Width="800"
        Height="400">

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="2*" />
        </Grid.ColumnDefinitions>

        <!-- Левая колонка -->
        <DockPanel Grid.Column="0" Margin="10">

            <StackPanel>
                <TextBlock Text="{Binding Greeting}" FontWeight="Bold" Margin="0,5"/>
                <Button Content="Найти" 
                        Command="{Binding SearchVM.SearchCommand}"
                        IsEnabled="{Binding SearchVM.IsEnablad}"
                        Margin="0,0,0,5"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        Width="85" 
                        />
                <Button Command="{Binding SearchVM.ClearCommand}"  Content="Очистить"     
                        Margin="0,0,0,5" />
            </StackPanel>
        </DockPanel>

        <!-- Вертикальный разделитель -->
        <Rectangle Grid.Column="1"
                    Width="1"
                    Fill="Gray"
                    Margin="0,10"
                    HorizontalAlignment="Center"/>
        <!-- Cодержимое правой колонки -->
        <Grid Grid.Column="2" 
                Margin="10"
                DataContext="{Binding SearchVM}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>   <!-- строка для заголовка -->
                <RowDefinition Height="*"/>      <!-- строка для TextBox, занимает всё оставшееся место -->
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0"
                    Text="Найденные устройства" 
                    FontWeight="Bold" 
                    Margin="0,5"/>
            <Grid Grid.Row="1" Margin="0,5">
                <!-- Список -->
                <ListBox
                    ItemsSource="{Binding Devices}"
                    SelectedItem="{Binding SelectedDevice}"
                    Margin="0,5"
                    IsVisible="{Binding IsListVisible}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" VerticalAlignment="Center"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <!-- Панель, когда список скрыт -->
                <Grid IsVisible="{Binding IsListVisible, Converter={x:Static BoolConverters.Not}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Button Content="Вернуть"
                            Command="{Binding ShowListCommand}"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Grid.Row="0"/>

                    <TextBox Text="Здесь может быть ваш текст"
                            IsReadOnly="True"
                            TextWrapping="Wrap"
                            Margin="0,5"
                            Grid.Row="1"
                            VerticalAlignment="Stretch"
                            HorizontalAlignment="Stretch"/>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>