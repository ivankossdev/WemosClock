<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:WemosClock.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="WemosClock.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="WemosClock"
        Width="800" Height="400">

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="2*" />
        </Grid.ColumnDefinitions>

        <!-- Левая колонка -->
        <DockPanel Grid.Column="0" Margin="10">

            <StackPanel>
                <TextBlock Text="{Binding SearchVM.Greeting}" FontWeight="Bold" Margin="0,5"/>
                <Button Content="Найти" 
                        Command="{Binding SearchVM.SearchCommand}"
                        IsEnabled="{Binding SearchVM.IsEnablad}"
                        Margin="0,0,0,5"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        Width="85"/>
            </StackPanel>
        </DockPanel>

        <!-- Вертикальный разделитель -->
        <Rectangle Grid.Column="1"
                    Width="1"
                    Fill="Gray"
                    Margin="0,10"
                    HorizontalAlignment="Center"/>
        <!-- Cодержимое правой колонки -->
        <ContentControl Grid.Column="2" 
                Margin="10" 
                Content="{Binding CurrentViewModel}"
                ContentTemplate="{StaticResource ViewLocator}" />
    </Grid>
</Window>