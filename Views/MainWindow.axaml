<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:WemosClock.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="WemosClock.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="WemosClock"
        Width="800"
        Height="400">

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="2*" />
        </Grid.ColumnDefinitions>

        <!-- Левая колонка -->
        <DockPanel Grid.Column="0" Margin="10">

            <StackPanel>
                <TextBlock Text="{Binding Greeting}" FontWeight="Bold" Margin="0,5"/>
                <Button Content="Найти" 
                        Command="{Binding SearchVM.SearchCommand}"
                        Margin="0,0,0,5"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        Width="85" 
                        />
                <Button Content="Очистить"     
                        Margin="0,0,0,5" />
            </StackPanel>
        </DockPanel>

        <!-- Вертикальный разделитель -->
        <Rectangle Grid.Column="1"
                   Width="1"
                   Fill="Gray"
                   Margin="0,10"
                   HorizontalAlignment="Center"/>
                   
        <!-- Cодержимое правой колонки -->
        <Grid Grid.Column="2" 
              Margin="10"
              DataContext="{Binding SearchVM}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>   <!-- строка для заголовка -->
                <RowDefinition Height="*"/>      <!-- строка для TextBox, занимает всё оставшееся место -->
            </Grid.RowDefinitions>

            <TextBlock Text="Найденные устройства:" 
                    FontWeight="Bold" 
                    Margin="0,5"
                    Grid.Row="0"/>

            <TextBox Text="{Binding NewResultText}"
                    IsReadOnly="True"
                    TextWrapping="Wrap"
                    Margin="0,5"
                    Grid.Row="1"
                    VerticalAlignment="Stretch"
                    HorizontalAlignment="Stretch"/>
        </Grid>
    </Grid>
</Window>